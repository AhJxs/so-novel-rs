#!/bin/sh
# pre-commit hook：自动格式化暂存的 .rs 文件并重新暂存（启用见 scripts/install-hooks.sh）。
# 只处理暂存区（A/C/M）的 *.rs：rustfmt --edition 2024 逐个格式化后重新 git add；
# 任一文件失败 → 非 0 退出阻断提交；无 .rs 暂存 → 立即放行。
# 跨平台：git 在 Windows 上经 git-bash 执行，POSIX shell 可用；rustfmt 与 cargo 同 PATH。

staged=$(git diff --cached --name-only --diff-filter=ACM -- '*.rs')

[ -z "$staged" ] && exit 0

fail=0
# 用 IFS 换行遍历，避免管道子壳导致 exit 无法退出脚本
IFS='
'
for file in $staged; do
    [ -f "$file" ] || continue
    if ! rustfmt --edition 2024 "$file"; then
        echo "rustfmt 失败：$file（提交已阻断，请修复后重试）" >&2
        fail=1
        continue
    fi
    git add "$file"
done
unset IFS

exit $fail
